{
  "mcpServers": {
    "mesa-ols": {
      "type": "stdio",
      "command": "${MESA_HOME}/.venv/bin/mesa-mcp",
      "args": ["--transport", "stdio"],
      "env": {
        "MESA_MCP_DUCKLAKE__CATALOG_DSN": "",
        "MESA_MCP_IRODS__USER": "anonymous",
        "MESA_MCP_SERVER__LOG_LEVEL": "warning"
      }
    }
  }
}
